# RentA-Fleet PRO — environment template.
# Copy to `.env` and fill in real values. DO NOT commit `.env`.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (relational / OLTP) ---
# Local dev: fill in the separate POSTGRES_* vars below.
# Hosted (Render/Neon/Heroku-style): set DATABASE_URL instead — a single
# connection string ("postgres://user:pass@host:port/dbname") takes
# precedence over POSTGRES_* when present (see settings.py).
# DATABASE_URL=
POSTGRES_DB=rentafleet
POSTGRES_USER=rentafleet
POSTGRES_PASSWORD=rentafleet
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# --- Production-only (leave unset for local dev) ---
# DJANGO_BEHIND_PROXY=true      # set true when behind a TLS-terminating proxy (Render, nginx, ALB)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# --- ClickHouse (analytics / time-series) ---
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=rentafleet_analytics
CLICKHOUSE_SECURE=false
CLICKHOUSE_CONNECT_TIMEOUT=10

# --- OpenAI (AI Fleet Consultant) ---
# Optional: leave blank to use the deterministic, data-grounded fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- CORS (frontend dev origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Piyasa fiyatları (Enuygun API) ---
# Run: python manage.py fetch_competitor_prices

# --- Redis (paylaşılan cache + Celery broker) ---
# Boş bırakılırsa: cache LocMemCache'e (süreç-içi, paylaşılmayan) düşer,
# Celery task'ları .delay() yerine senkron/doğrudan çağrılır. Üretimde
# ayarlanmalıdır: redis://<host>:6379/0
REDIS_URL=

# --- Sentry (hata izleme / APM) ---
# Optional: boş bırakılırsa Sentry hiç başlatılmaz.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=

# --- Loglama biçimi ---
# "text" (varsayılan, okunur) veya "json" (üretim log toplama araçları için).
DJANGO_LOG_FORMAT=text
DJANGO_LOG_LEVEL=INFO
